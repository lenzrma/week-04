@startuml
left to right direction
skinparam classAttributeIconSize 0

class Student {
    - studentId: String
    - name: String
    + viewAvailability()
    + bookRoom()
    + cancelBooking()
}

class Room {
    - roomId: String
    - roomNumber: String
    - isBlocked: boolean
    + isAvailable(): boolean
    + setBlocked(blocked: boolean)
}

class Booking {
    - bookingId: String
    - startTime: DateTime
    - endTime: DateTime
    - status: String
    + confirm()
    + cancel()
}

class Administrator {
    - adminId: String
    - name: String
    + blockRoom()
    + unblockRoom()
    + reviewUsage()
}

Student "1" -- "0..*" Booking : makes >
Room "1" -- "0..*" Booking : has >
Administrator "1" -- "*" Room : manages / blocks >

note bottom of Booking
  R2: Active bookings for the same room cannot overlap.
end note

@enduml